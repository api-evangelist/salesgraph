          "id": "fff18643-93dc-450f-aad3-ef54fb09b102",
          "name": "Start the org audit shortcut",
          "request": {
            "name": "Start the org audit shortcut",
            "description": {
              "content": "Starts your org's audit. By default returns 202 with a run id to poll. Pass `{\"wait\": true}` (or `?wait=true`) to block until the audit finishes — this can take several minutes and returns 504 if it exceeds the server timeout (the run keeps going).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "audit"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "wait",
                  "value": "<boolean>",
                  "description": "Block until the audit finishes and return the result inline."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/markdown"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wait\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
