          "id": "293b2f2b-00ca-4d43-8a4d-b81c78da53a4",
          "name": "Run a command",
          "request": {
            "name": "Run a command",
            "description": {
              "content": "Runs one of `research`, `competitors`, `gtm-audit`, `audit`, or `help`. Send the command's arguments as a JSON body. Sync commands return 200 with markdown; async commands return 202 with a run id in the `X-Run-Id`/`X-Audit-Id` header.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "commands",
                ":command"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "command",
                  "description": "(Required) The command to run."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/markdown"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"<string>\",\n  \"company\": \"<string>\",\n  \"website\": \"<string>\",\n  \"userContext\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
